---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Workbench parts drifting in the page margins. Not on posts: prose wants a still page. */
  ambient?: boolean;
}
const { title, description, ambient = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/#building', label: 'Building' },
  { href: '/#shipped', label: 'Shipped' },
  { href: '/blog/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
];
---
<!doctype html>
<html lang="en" data-palette="brick">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Petko (Pete) Pavlovski" href="/rss.xml" />
  <slot name="head" />

  <!-- Preload both faces: they are render-blocking for the mono labels and the
       terminal, which is most of what the page is. -->
  <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Favicons, drawn from the same geometry as the nav mark. SVG first for any
       browser that takes it, .ico for the ones that still ask, PNG for iOS. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#171614" />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />

</head>
<body>
  {ambient && <canvas class="ambient" id="ambient" aria-hidden="true"></canvas>}
  <a class="skip" href="#main">Skip to content</a>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="prompt" viewBox="0 0 24 24">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" d="M4 6l5 6-5 6M13 18h7"/>
    </symbol>
  </svg>

  <header>
    <nav class="nav">
      <a class="brand" href="/"><svg aria-hidden="true"><use href="#prompt"/></svg>cargopete</a>
      <div class="nav-links">
        {nav.map((l) => (
          <a href={l.href} aria-current={!l.href.includes('#') && path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>
      <a class="nav-cta fd-btn fd-btn--primary" href="/#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap foot">
      <div>
        <span class="brand"><svg aria-hidden="true"><use href="#prompt"/></svg>cargopete</span>
        <p class="sig">Written in Sofia ·no trackers, no third-party requests</p>
      </div>
      <div class="foot-links">
        <a href="/resume/">Resume</a>
        <a href="https://github.com/cargopete">GitHub</a>
        <a href="https://github.com/nuthatch-org" rel="external noopener">The Night's Watch</a>
        <a href="https://nuthatch-indexer.com" rel="external noopener">nuthatch</a>
        <a href="https://redstart-lang.com" rel="external noopener">redstart</a>
        <a href="https://yetanothertaskrunner.com" rel="external noopener">yatr</a>
        <a href="mailto:pavlovskipetko@gmail.com">Mail</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    // The whole client-side budget for this site: copy-to-clipboard and the
    // reveal below. No framework, no islands, no third party.
    document.querySelectorAll('.fd-install[data-copy]').forEach((el) => {
      const hint = el.querySelector('.h');
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.dataset.copy.trim());
          el.classList.add('copied');
          hint.textContent = 'copied';
          setTimeout(() => { el.classList.remove('copied'); hint.textContent = 'copy'; }, 1400);
        } catch (e) { /* insecure origin or denied: the text is still selectable */ }
      });
    });


    // One entrance, below the fold, via IntersectionObserver rather than a
    // scroll listener. Elements start visible in the markup, so a crawler and a
    // reduced-motion reader both get the finished page.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const targets = document.querySelectorAll('[data-reveal]');
      targets.forEach((el) => el.classList.add('reveal'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '-40px' });
      targets.forEach((el) => io.observe(el));
    }
  </script>

  <script is:inline type="module">
    // Scenery, never content: loaded after first paint from this site, and if
    // WebGL or the import fails the page is already complete without it.
    const hero = document.getElementById('landscape');
    const ambient = document.getElementById('ambient');
    if (hero || ambient) {
      const go = () => import('/foundry/scenes.js').then((S) => {
        try { if (hero) S.createWorkbench(hero); } catch (e) { hero.remove(); }
        try {
          if (ambient) {
            // createAmbient clears only 0.78 of the width it is given, so give it the
            // column divided by that, or parts sit behind the first letters of a line.
            const wrap = document.querySelector('main .wrap');
            S.createAmbient(ambient, { kit: 'workbench', contentWidth: (wrap ? wrap.getBoundingClientRect().width : 1296) / 0.78 });
          }
        } catch (e) { ambient.remove(); }
      }).catch(() => {});
      const later = () => requestAnimationFrame(() => setTimeout(go));
      if (document.readyState === 'complete') later();
      else addEventListener('load', later, { once: true });
    }
  </script>
</body>
</html>
