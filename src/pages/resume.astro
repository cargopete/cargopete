---
import Layout from '../layouts/Layout.astro';

import { resume } from '../data/resume';

const { contact, history, scope, close } = resume;
const jobs = resume.jobs.map((job) => ({ ...job, when: `${job.from} - ${job.to} · ${job.where}` }));
---

<Layout
  ambient
  title={resume.page.title}
  description={resume.page.description}
>
  <link slot="head" rel="alternate" type="application/pdf" href="/resume/petko-pavlovski-resume.pdf" />

  <section id="top">
    <div class="wrap">
      <span class="fd-badge fd-badge--accent hero-badge rise rise-1"><span class="fd-dot"></span>{contact.location}</span>
      <h1 class="display rise rise-2">{resume.page.headline}</h1>
      <p class="lede rise rise-2" style="max-width: 48ch;">
        {resume.tenure} {resume.accountant}
      </p>
      <div class="btn-row rise rise-3">
        <button class="fd-install" data-copy={contact.email}
                aria-label="Copy my email address to the clipboard">
          <span class="p">$</span><span class="c">{contact.email}</span>
          <span class="h">copy</span>
        </button>
        <a class="fd-btn fd-btn--ghost" href="/#building">See what I am building</a>
        <a class="fd-btn fd-btn--ghost" href="/resume/petko-pavlovski-resume.pdf" download>Download resume (PDF)</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- HISTORY -->
  <section id="history">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="fd-kicker">{history.kicker}</p>
        <h2 class="fd-h1 display-sm">{history.heading}</h2>
        <p class="fd-lede">
          {history.lede}
        </p>
      </div>

      <div class="timeline">
        {jobs.map((job) => (
          <div class={job.now ? 'job job--now' : 'job'} data-reveal>
            <div class="job-head">
              <h3>{job.href
                ? <a href={job.href} rel="external noopener">{job.company}</a>
                : job.company}</h3>
              <span class="job-role">{job.role}</span>
            </div>
            <div class="job-when">{job.when}</div>
            <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- SCOPE -->
  <section id="scope">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="fd-kicker">{scope.kicker}</p>
        <h2 class="fd-h1 display-sm">{scope.heading}</h2>
        <p class="fd-lede">
          {scope.lede[0]}
          <a href={contact.linkedinUrl} rel="external noopener">LinkedIn</a> {scope.lede[1]}
        </p>
      </div>

      <div class="scope" data-reveal>
        <div class="scope-col">
          <p class="scope-label scope-label--in">{scope.inLabel}</p>
          <ul>{scope.in.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="scope-col">
          <p class="scope-label scope-label--out">{scope.outLabel}</p>
          <ul>{scope.out.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>

      <p class="scope-note">
        {scope.note}
      </p>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="closer" id="contact">
    <div class="wrap">
      <div data-reveal>
        <p class="fd-kicker">{close.kicker}</p>
        <h2 class="fd-h1 display-sm">{close.heading}</h2>
        <p class="fd-lede">
          {close.lede}
        </p>
        <div class="cta-row">
          <button class="fd-install" data-copy={contact.email}
                  aria-label="Copy my email address to the clipboard">
            <span class="p">$</span><span class="c">{contact.email}</span>
            <span class="h">copy</span>
          </button>
          <a class="ghost" href="/">Back to the work <span class="arrow">&rsaquo;</span></a>
        </div>
        <div class="links">
          <a href={`https://${contact.github}`}>{contact.github}</a>
          <a href="https://github.com/nuthatch-org" rel="external noopener">The Night's Watch</a>
          <a href={contact.linkedinUrl} rel="external noopener">LinkedIn</a>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
