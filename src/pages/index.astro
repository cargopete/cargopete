---
import Layout from '../layouts/Layout.astro';
import { portfolio } from '../data/portfolio';
import { resume } from '../data/resume';
const { contact } = resume;
---
<Layout
  ambient
  title="Petko Pavlovski | Senior Rust Engineer | Backend & Distributed Systems"
  description="Senior Rust engineer at Fathom. Creator of Matchstick, builder of nuthatch and Graphcast. Production software since 2019. Sofia, remote."
>
  <section id="top" class="portfolio-hero hero">
    <canvas class="hero-scene" id="landscape" aria-hidden="true"></canvas>
    <div class="scan" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-heading rise rise-1">
        <p class="fd-kicker">Petko (Pete) Pavlovski</p>
        <span class="hero-location">Sofia, Bulgaria · remote since 2019</span>
      </div>
      <div class="portfolio-grid">
        <div>
          <p class="hero-role rise rise-1">{portfolio.role}</p>
          <h1 class="portfolio-title rise rise-2">I write the part<br>that has to <span>stay up.</span></h1>
          <p class="portfolio-intro rise rise-2">{portfolio.summary}</p>
          <div class="btn-row rise rise-3">
            <a class="fd-btn fd-btn--primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
            <a class="fd-btn fd-btn--ghost" href="/resume/petko-pavlovski-resume.pdf" download>Download CV <span class="mono">PDF</span></a>
          </div>
          <p class="hero-contact rise rise-3"><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`https://${contact.github}`}>GitHub</a><a href={contact.linkedinUrl}>LinkedIn</a></p>
        </div>
        <aside class="work-index rise rise-3" aria-label="Selected work index">
          <div class="index-heading"><span>Selected systems</span><span>01 / 03</span></div>
          {portfolio.selected.map((project, index) => (
            <a href={`#${project.id}`} class="index-entry">
              <span class="index-number">0{index + 1}</span>
              <span><strong>{project.name}</strong><small>{project.label}</small></span>
              <span class="index-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <p class="index-foot">Code, context and my contribution below.</p>
        </aside>
      </div>
      <div class="career-strip">
        <p><span class="strip-label">Now</span><a href="https://fathom.io">Fathom</a><span>Rust backend · AI data platform</span></p>
        <p><span class="strip-label">Previously</span><span>The Graph / GraphOps</span><span>Kraken</span><span>OVO Energy</span></p>
      </div>
    </div>
  </section>
  <section id="work" class="selected-work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="fd-kicker">Selected work</p>
        <h2 class="fd-h1 display-sm">The work, with the source attached.</h2>
        <p class="fd-lede">A testing framework, an indexer and a messaging protocol. Different systems, the same concern: what happens when somebody else has to rely on them.</p>
      </div>
      {portfolio.selected.map((project, index) => (
        <article id={project.id} class="case-study" data-reveal>
          <div class="case-identity">
            <span class="case-number" aria-hidden="true">0{index + 1}</span>
            <p class="fd-kicker">{project.label}</p>
            <h3>{project.name}</h3>
            <p class="case-context">{project.context}</p>
            <ul class="case-tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul>
          </div>
          <div class="case-content">
            <h4>{project.title}</h4>
            <dl class="case-details">
              <div><dt>The problem</dt><dd>{project.problem}</dd></div>
              <div><dt>My work</dt><dd>{project.contribution}</dd></div>
              <div><dt>The result</dt><dd>{project.result}</dd></div>
            </dl>
            <div class="evidence-links">{project.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="building" class="more-work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="fd-kicker">Also building</p>
        <h2 class="fd-h1 display-sm">Tools I wanted to exist.</h2>
        <p class="fd-lede">Independent projects, built in public. From the compiler to the operator’s screen.</p>
      </div>
      <div class="project-grid">
        {portfolio.building.map(project => (
          <article class="project-note" data-reveal>
            <p class="fd-kicker">{project.kind}</p>
            <h3><a href={project.href}>{project.name}</a></h3>
            <p>{project.text}</p>
            <span class="project-stack">{project.tags}</span>
            <div class="evidence-links"><a href={project.href}>Visit project <span aria-hidden="true">↗</span></a><a href={project.source}>Source <span aria-hidden="true">↗</span></a></div>
          </article>
        ))}
      </div>
      <p class="community-note">More operator tools in <a href="https://github.com/nuthatch-org">The Night’s Watch</a>, and protocol explainers at <a href="https://learn-thegraph.com">Learn The Graph</a>.</p>
    </div>
  </section>
  <section id="experience" class="experience-summary">
    <div class="wrap experience-grid">
      <div class="section-head" data-reveal>
        <p class="fd-kicker">In production since 2019</p>
        <h2 class="fd-h1 display-sm">From the test harness to the service.</h2>
        <p class="fd-lede">{portfolio.current}</p>
        <a class="text-link" href="/resume/">Full experience & CV <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="career-list" aria-label="Recent experience">
        {resume.jobs.slice(0, 4).map(job => (
          <li><span class="career-dates">{job.from} - {job.to}</span><h3>{job.company}{job.org && <span> / {job.org}</span>}</h3><p>{job.role}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <section class="closer" id="contact">
    <div class="wrap">
      <p class="fd-kicker">Let’s talk systems</p>
      <h2 class="fd-h1 display-sm">What are you building?</h2>
      <p class="fd-lede">{portfolio.contact}</p>
      <p class="contact-location">Sofia · remote · European working hours</p>
      <div class="cta-row">
        <a class="fd-btn fd-btn--primary" href={`mailto:${contact.email}`}>Email Pete <span aria-hidden="true">↗</span></a>
        <a class="fd-btn fd-btn--ghost" href="/resume/">Read the CV</a>
      </div>
      <div class="links"><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={contact.linkedinUrl}>LinkedIn</a><a href={`https://${contact.github}`}>GitHub</a></div>
    </div>
  </section>
</Layout>
