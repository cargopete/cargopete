---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Layout
  title={`${post.data.title} - Petko (Pete) Pavlovski`}
  description={post.data.description}
>
  <section>
    <article class="wrap post prose">
      <a href="/blog/" class="back">&larr; Writing</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.tags.length > 0 && (
          <><span aria-hidden="true"> · </span>{post.data.tags.join(' · ')}</>
        )}
      </div>
      <Content />
      <hr class="divider" style="margin-top: 3.4rem;" />
      <p class="foot-note">
        <a href="/blog/">Every post</a> · <a href="/rss.xml">Feed</a> ·
        <a href="mailto:pavlovskipetko@gmail.com">Tell me I am wrong</a>
      </p>
    </article>
  </section>
</Layout>

<style>
  /* Wider than the 44rem `.narrow`: a post carries code blocks and tables that
     a 44rem column crops. Scoped, so none of this prose CSS is inlined into the
     homepage, which has no prose on it. */
  .post { max-width: 52rem; }
  .prose .back {
    display: inline-block; font-family: var(--font-mono); font-size: 0.6875rem;
    color: var(--text-muted); margin-bottom: 1.6rem; border-bottom: 0;
  }
  .prose .back:hover { color: var(--text); text-decoration: none; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.08;
       margin-bottom: 0.4rem; letter-spacing: -0.04em; }
  .prose .meta {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-muted); margin: 0.7rem 0 2.6rem;
  }
  .prose .foot-note { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.02em;
               color: var(--text-muted); margin-top: 1.6rem; }

  /* Scoped under .prose so they outrank the markdown rules below. */

  /* --- markdown body --------------------------------------------------- */
  .prose :global(p) { color: var(--text-muted); font-size: 1rem; line-height: 1.75; margin-bottom: 1.35rem; }
  .prose :global(p:first-of-type) { color: var(--text); }
  .prose :global(h2) { font-size: 1.375rem; letter-spacing: -0.03em; color: var(--text);
                       margin: 2.8rem 0 1rem; line-height: 1.25; }
  .prose :global(h3) { font-size: 1.125rem; letter-spacing: -0.03em; color: var(--text);
                       margin: 2rem 0 0.75rem; }
  .prose :global(a) { color: var(--accent);
                      border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .prose :global(a:hover) { border-bottom-color: var(--accent); text-decoration: none; }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(ul), .prose :global(ol) {
    color: var(--text-muted); font-size: 1rem; line-height: 1.7;
    margin: 0 0 1.35rem; padding-left: 1.3rem;
  }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.6rem 0; }
  .prose :global(blockquote) {
    margin: 1.6rem 0; padding: 0.4rem 0 0.4rem 1.2rem;
    border-left: 3px solid var(--accent); color: var(--text-muted); font-style: italic;
  }
  .prose :global(blockquote p) { margin-bottom: 0.5rem; }
  /* A wide table scrolls inside itself rather than dragging the page sideways. */
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 0 0 1.6rem;
                          font-size: 0.875rem; }
  .prose :global(th), .prose :global(td) {
    border-bottom: 1px solid var(--border); padding: 0.6rem 0.8rem 0.6rem 0;
    text-align: left; color: var(--text-muted);
  }
  .prose :global(th) { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.6875rem;
                       letter-spacing: 0.02em; text-transform: uppercase; font-weight: 400; }

  /* --- code ------------------------------------------------------------- */
  .prose :global(code) {
    font-family: var(--mono); font-size: 0.86em; background: var(--bg-inset);
    padding: 0.12em 0.36em; border-radius: var(--radius-sm); color: var(--text);
  }
  .prose :global(pre) {
    background: var(--bg-code); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1rem 1.1rem; overflow-x: auto; margin: 0 0 1.5rem;
    font-size: 0.75rem; line-height: 1.85;
  }
  .prose :global(pre code) { background: none; padding: 0; border-radius: 0; font-size: inherit; }
</style>
